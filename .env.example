# Public configuration example; never copy credentials from an existing story.
# Core API and Connection Configuration
# -----------------------------------------------------------------
# Ensure these point to your running LLM and Neo4j services.
OPENAI_API_BASE="http://127.0.0.1:8080/v1"
OPENAI_API_KEY="sk-nope"
EMBEDDING_API_BASE="http://127.0.0.1:11434"
EMBEDDING_API_KEY=""
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="saga_password"

# -----------------------------------------------------------------
# Model Assignments (shipped placeholders, not a verified server catalog)
# -----------------------------------------------------------------
# Replace these with exact model IDs offered by your deliberately selected endpoint.
LARGE_MODEL="qwen3-a3b"
MEDIUM_MODEL="qwen3-a3b"
SMALL_MODEL="qwen3-a3b"
NARRATIVE_MODEL="qwen3-a3b"
LLM_TOP_P=0.95
TEMPERATURE_OVERRIDE=1.0
# Provider wire flag only; application schema/catalog validation remains strict.
STRUCTURED_OUTPUT_STRICT=False

EMBEDDING_MODEL="nomic-embed-text:latest"
EXPECTED_EMBEDDING_DIM=768
NEO4J_VECTOR_DIMENSIONS=768

# -----------------------------------------------------------------
# Generation & Revision Parameters
# -----------------------------------------------------------------
CHAPTERS_PER_RUN=3
TARGET_PLOT_POINTS_INITIAL_GENERATION=12
# Total provider context must also accommodate the prompt and schema.
MAX_CONTEXT_TOKENS=131072
MAX_GENERATION_TOKENS=65536
MAX_PLANNING_TOKENS=65536
MAX_SUMMARY_TOKENS=65536
MAX_KG_TRIPLE_TOKENS=65536
MAX_PREPOP_KG_TOKENS=65536
TARGET_SCENES_MIN=4
TARGET_SCENES_MAX=6

# -----------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------
LOG_LEVEL="INFO"
